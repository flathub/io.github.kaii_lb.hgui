{
  "app-id": "io.github.kaii_lb.hgui",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "hgui-rust",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "build-args": [],
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LOG": "hgui-rust=debug",
      "CARGO_NET_OFFLINE": "true",
      "CARGO_HOME": "/run/build/hgui-rust/cargo"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "blueprint-compiler",
      "buildsystem": "meson",
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler.git",
          "tag": "v0.18.0"
        }
      ]
    },
    {
      "name": "hgui-rust",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts": [
        "-Dbuildtype=release"
      ],
      "sources": [
        "cargo-sources.json",
        {
          "type": "git",
          "url": "https://github.com/kaii-lb/hgui-rust",
          "commit": "0fc7f9b55ac56828b4e7aa4672cb7e0d493100fc"
        }
      ]
    }
  ]
}
